<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- IIS URL Rewrite Module configuration -->
    <rewrite>
      <rules>
        <rule name="Main Rule" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
    </rewrite>

    <!-- iisnode configuration -->
    <iisnode
      nodeProcessCommandLine="&quot;%ProgramFiles%\nodejs\node.exe&quot; src/server.js"
      interceptor="&quot;%ProgramFiles%\iisnode\interceptor.js&quot;"
      loggingEnabled="true"
      logDirectory="..\logs"
      watchedFiles="web.config;*.js"
      nodeProcessCountPerApplication="1"
      maxLogFileSizeInKB="128"
      maxTotalLogFileSizeInKB="1024"
      maxLogFiles="20"
    />

    <!-- WebSocket support -->
    <webSocket enabled="false" />

    <!-- Security headers -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>

    <!-- Static content handling -->
    <staticContent>
      <mimeType fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <!-- Handler for Node.js -->
    <handlers>
      <add name="iisnode" path="src/server.js" verb="*" modules="iisnode" />
    </handlers>
  </system.webServer>

  <!-- Node.js app settings -->
  <appSettings>
    <add key="NODE_ENV" value="production" />
  </appSettings>
</configuration>
