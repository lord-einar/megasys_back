NODE_ENV=development
PORT=3000

# Base de datos
# Para Railway, puedes usar DATABASE_URL o variables individuales
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_empresarial
DB_USER=mgft_infra_app
DB_PASSWORD=your_secure_password_here
DB_DIALECT=postgres

# Cloudflare R2 Storage (para PDFs)
R2_ACCOUNT_ID=f6f0056b144919ae1af9805b3239a209
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=megasys-remitos
R2_PUBLIC_URL=https://files.tudominio.com  # Opcional: custom domain configurado en R2
# Alternativamente, puedes usar R2_ENDPOINT directamente:
# R2_ENDPOINT=https://f6f0056b144919ae1af9805b3239a209.r2.cloudflarestorage.com

# JWT
JWT_SECRET=tu_jwt_secret_super_seguro_aqui_cambialo
JWT_EXPIRES_IN=24h

# Microsoft Entra ID (Azure AD)
AZURE_CLIENT_ID=tu_client_id
AZURE_CLIENT_SECRET=tu_client_secret
AZURE_TENANT_ID=tu_tenant_id
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# CORS
CORS_ORIGIN=http://localhost:5173

# Frontend URLs (used for confirmation links in emails)
FRONTEND_URL=http://localhost:5173
FRONTEND_LOGIN_URL=http://localhost:5173/login

# Email/SMTP Configuration (for remito confirmation emails)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=remitos@megatlon.com.ar
SMTP_PASSWORD=tu_password_aqui
SMTP_FROM=remitos@megatlon.com.ar
EMAIL_INFRAESTRUCTURA=infraestructura@megatlon.com.ar
EMAIL_COMPRAS=compras@megatlon.com.ar

# JWT Configuration (for confirmation tokens)
CONFIRMATION_TOKEN_EXPIRES=30d
